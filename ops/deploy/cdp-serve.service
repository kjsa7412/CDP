[Unit]
Description=CDP MCP server (ctx serve)
Documentation=file:///opt/cdp/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cdp
Group=cdp
WorkingDirectory=/opt/cdp

# 설정은 serve.json 한 장이다(제품화 2 F5) — root · auth · data · web · bind · port · mirror.
# install.sh 가 만들고, `cdp serve doctor` · `cdp serve user …` 같은 셸 명령도 같은 장을 읽는다.
#
# bind 는 **그 인터페이스 하나에만** 연다. 0.0.0.0 으로 열지 않는다 — 프록시가 없는 배치라 여기가 유일한 경계다.
# auth 가 없으면 서버가 시작을 거부한다(설계서 §8). 서식집(forms/) · kit/ · web/ 은 bin/ 옆을 스스로 찾는다.
ExecStart=/usr/bin/node /opt/cdp/bin/ctx.mjs serve --config /opt/cdp/serve.json

Restart=always
RestartSec=5

# 로그는 stderr 로 나가고 serve.log 에도 쌓인다(3×1MB 회전).
# journald 는 그것을 한 번 더 받는다 — 서비스가 시작조차 못 할 때 볼 곳이다.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cdp-serve

# 서버는 /opt/cdp 밖을 쓸 일이 없다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cdp
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
