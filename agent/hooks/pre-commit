#!/bin/sh
# 지식 레포 pre-commit — 작업환경 v1.1 §8.3.
#
# **세션 층(skill)은 비결정적이다. 이것이 유일한 결정론적 보증이다.**
# 사람이 손으로 써도, 다른 LLM 이 써도, skill 을 건너뛰어도 여기서 걸린다.
#
# 훅은 clone 을 따라오지 않는다:
#     git config core.hooksPath .githooks
#
# 이 파일이 sh 인 이유 -- git 이 있으면 sh 도 있다. Git for Windows 가
# bash 를 함께 깔고 훅을 그 위에서 돌린다.

repo=$(git rev-parse --show-toplevel)
ctx="$repo/bin/ctx"

if [ ! -x "$ctx" ] && [ ! -f "$ctx" ]; then
  # 도구가 없으면 **막지 않는다.** 검사를 못 하는 것과 검사에 실패한 것은
  # 다르고, 전자로 커밋을 막으면 도구가 깨진 날 아무도 일하지 못한다.
  echo "[pre-commit] bin/ctx 가 없어 검사를 건너뜁니다." >&2
  echo "             (작업환경 설계서 3.1 -- 번들을 다시 넣으세요)" >&2
  exit 0
fi

# 1) 검사. error 등급이 있으면 exit 1.
#
#    **밀림도 error 다** (정정_판정모델_v2 §1). 지식공유문서를 남기면서 관리
#    문서 파생은 필수이고, 선택이 아니다.
#
#    "밀린 것이 있는 동안 커밋을 못 하면 --no-verify 를 쓴다"는 걱정은
#    **막히는 것을 착각한 것**이다. 막히는 것은 코드 커밋이 아니라 지식 레포
#    커밋이고, 그것은 작업이 끝난 뒤에 하는 일이라 급할 이유가 없다.
sh "$ctx" check --repo "$repo"
rc=$?

# **127 = 실행기가 없다.** 검사 실패(1)와 다르다.
#
# 폐쇄망 실측에서 이 둘을 구분 안 했더니, git 은 있고 Node·exe 가 없는 PC 에서
# 커밋이 전부 막혔다. **검사를 못 하는 것과 검사에 실패한 것은 다르고**,
# 전자로 막으면 도구가 없는 날 아무도 일하지 못한다.
if [ "$rc" -eq 127 ]; then
  echo "[pre-commit] 검사를 건너뜁니다 -- ctx 를 실행할 수 없습니다." >&2
  echo "             (Node 도 tools/cdp.exe 도 없습니다. 작업환경 설계서 3.1)" >&2
  echo "             **커밋은 통과하지만 검사는 돌지 않았습니다.**" >&2
  exit 0
fi

if [ "$rc" -ne 0 ]; then
  echo "" >&2
  echo "[pre-commit] 커밋을 중단했습니다." >&2
  echo "             고친 뒤 다시 커밋하세요. --no-verify 로 넘기지 마세요." >&2
  exit 1
fi

# 2) INDEX 재생성 후 이 커밋에 포함.
#
#    사람이 손으로 맞추면 반드시 어긋난다. 어긋난 INDEX 는 "그 문서가 없다"로
#    읽히므로 조용한 실패가 된다(프로토콜 §9.6).
before=$(git diff --cached --name-only)
sh "$ctx" index --repo "$repo" >/dev/null 2>&1 || true

#    **`git diff` 는 추적 안 되는 파일을 차이로 보지 않는다.** 그래서 전에는
#    `! git diff --quiet` 하나로만 걸었는데, 갓 부은 레포의 첫 커밋에서는
#    INDEX 가 아직 추적 대상이 아니라 이 검사가 "차이 없음"을 내고 **영원히
#    스테이지에 안 올라갔다.** 배포본을 부어 커밋해 보니 `?? INDEX.md` 로
#    남아 있었다. 추적 여부를 먼저 묻는다.
for f in INDEX.md INDEX-by-coord.md; do
  [ -f "$repo/$f" ] || continue
  if ! git ls-files --error-unmatch -- "$f" >/dev/null 2>&1 ||
     ! git diff --quiet -- "$f" 2>/dev/null; then
    git add "$repo/$f"
    echo "[pre-commit] $f 를 갱신해 커밋에 포함했습니다." >&2
  fi
done

# 스테이지가 통째로 비어 버리는 일은 없어야 한다 -- 그러면 커밋이 조용히
# 빈 커밋이 되거나 실패한다.
if [ -z "$before" ]; then
  echo "[pre-commit] 스테이지가 비어 있습니다." >&2
  exit 1
fi

exit 0
