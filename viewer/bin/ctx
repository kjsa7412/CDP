#!/bin/sh
# ctx - 실행기를 고른다.  작업환경 v1.1 §3.1
#
# 폐쇄망 PC 에 Node 가 없다고 전제한다. Node 가 없으면 `bin/ctx.mjs` 를 실행할
# 수 없고, 그러면 git 훅이 `ctx check` 를 못 불러 **보증 층이 통째로 사라진다.**
# 그래서 exe 로 넘긴다 -- exe 는 Node 런타임과 같은 구현을 품고 있다.
#
# 이 파일이 sh 인 이유: git 이 있으면 sh 도 있다. Git for Windows 가 bash 를
# 함께 깔고 git 훅을 그 위에서 돌린다. git 이 없으면 훅 자체가 없으므로
# 이 경로는 어차피 필요하지 않다.
set -e
here=$(dirname "$0")

# 1) Node 가 있으면 그것으로. 빠르고 오류 메시지가 자세하다
if command -v node >/dev/null 2>&1 && [ -f "$here/ctx.mjs" ]; then
  exec node "$here/ctx.mjs" "$@"
fi

# 2) 없으면 exe 로. 레포 안 -> 상위 -> PATH 순으로 찾는다
for exe in "$here/../tools/cdp.exe" "$here/../tools/ctx-view.exe" "$here/../../tools/cdp.exe"; do
  if [ -x "$exe" ]; then exec "$exe" ctx "$@"; fi
done
if command -v cdp.exe >/dev/null 2>&1; then exec cdp.exe ctx "$@"; fi

# 실행기가 없다. **exit 127 로 낸다 -- 검사 실패(1)와 구분해야 한다.**
#
# 폐쇄망 실측에서 이걸 1 로 냈더니 git 훅이 "검사 실패" 로 읽고 커밋을 막았다.
# git 은 있고 Node·exe 가 없는 PC 에서 **아무도 커밋을 못 하게 된다.**
# 그리고 메시지가 "고친 뒤 다시 커밋하세요" 라 사용자는 자기 문서가 잘못된
# 줄 안다 -- 실제로는 도구가 못 도는 것이다.
#
# 127 은 셸 관례로 "command not found" 다. 훅이 이 값을 보고 건너뛴다.
echo "ctx: node 도 cdp.exe 도 없습니다." >&2
echo "     tools/cdp.exe 를 두거나 PATH 에 넣으세요. (작업환경 설계서 3.1)" >&2
exit 127
