{
  "name": "cdp",
  "private": true,
  "version": "0.3.5",
  "type": "module",
  "description": "CDP 작업 환경 — 지식 레포 뷰어 + ctx 도구",
  "bin": {
    "cdp": "server/index.js"
  },
  "scripts": {
    "dev": "vite --config viewer/vite.config.js",
    "dev:server": "node viewer/server/index.js --repo ./sample-repo --dev http://localhost:5173 --no-open",
    "build": "vite build --config viewer/vite.config.js",
    "start": "node viewer/server/index.js --repo ./sample-repo",
    "seed": "node ops/lib/seed.mjs",
    "ctx": "node viewer/bin/ctx-cli.mjs",
    "build:ctx": "node ops/lib/build-ctx.mjs",
    "build:exe": "node ops/lib/build-exe.mjs",
    "release": "node ops/lib/release.mjs",
    "test:tray": "node ops/lib/tray-selftest.mjs"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "minisearch": "^7.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "rcedit": "^4.0.1",
    "vite": "^6.0.7"
  }
}
