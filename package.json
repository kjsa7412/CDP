{
  "name": "cdp",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "description": "CDP — 지식 레포 서버(MCP · 화면 · ctx) · 작업 기록과 큐레이션",
  "scripts": {
    "dev": "vite --config viewer/vite.config.js",
    "dev:server": "node viewer/bin/ctx-cli.mjs serve --personal viewer/fixture --port 7373 --data ops/out/dev-personal",
    "build": "vite build --config viewer/vite.config.js",
    "start": "node viewer/bin/ctx-cli.mjs serve --personal viewer/fixture --port 7373 --data ops/out/dev-personal --web ops/out/web",
    "seed": "node ops/lib/seed.mjs",
    "ctx": "node viewer/bin/ctx-cli.mjs",
    "build:ctx": "node ops/lib/build-ctx.mjs",
    "test": "node --test test/",
    "verify": "node ops/verify/run.mjs",
    "release:server": "node ops/lib/release-server.mjs",
    "dev:site": "vite --config site/vite.config.js",
    "build:site": "vite build --config site/vite.config.js && node site/tools/prerender.mjs && node site/tools/check-leaks.mjs",
    "site:demo": "node site/demo/run.mjs",
    "preview:site": "node site/tools/serve-static.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.63.0",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
