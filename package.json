{
  "name": "cdp",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "CDP 작업 환경 — 지식 레포 뷰어 + ctx 도구",
  "bin": {
    "cdp": "server/index.js"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.js --repo ./sample-repo --dev http://localhost:5173 --no-open",
    "build": "vite build",
    "start": "node server/index.js --repo ./sample-repo",
    "sample": "python tools/seed_repo.py",
    "build:exe": "node tools/build-exe.mjs",
    "icon": "node tools/make-icon.mjs",
    "ctx": "node bin/ctx-cli.mjs",
    "build:ctx": "node tools/build-ctx.mjs",
    "seed": "python tools/seed_repo.py",
    "sample:gdi-old": "python tools/make_sample_repo_gdi.py",
    "release": "npm run build && npm run build:exe && npm run sample"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "minisearch": "^7.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "rcedit": "^4.0.1",
    "vite": "^6.0.7"
  }
}
